# ============================================================================
#  Zuhma Client Portal — variables de entorno (plantilla)
#  Copia a `.env` (backend) y `frontend/.env.local`. NUNCA commitees los reales.
# ============================================================================

# ---------------------------------------------------------------------------
# BACKEND (FastAPI BFF)
# ---------------------------------------------------------------------------

# --- Odoo (cuenta de SERVICIO, no per-usuario) ---
# Usuario dedicado de Odoo con lectura de facturación/helpdesk/CRM/proyectos
# de todos los partners cliente. La API key vive SOLO aquí.
ODOO_URL=https://tuempresa.odoo.com
ODOO_DB=tuempresa
ODOO_SERVICE_LOGIN=portal-service@zuhma.online
ODOO_SERVICE_API_KEY=CHANGME_api_key_de_odoo

# --- Base de datos propia (Postgres) ---
# En docker-compose se resuelve al servicio `db`. En local apunta a tu Postgres.
DATABASE_URL=postgresql+psycopg://zuhma:zuhma@db:5432/zuhma_portal

# --- Supabase Auth (lo entrega Oswaldo) ---
# El BFF valida el JWT de Supabase contra el JWKS del proyecto.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUD=authenticated
# Alternativa a JWKS: secreto JWT legacy (solo si usas HS256). Prefiere JWKS (RS256/ES256).
SUPABASE_JWT_SECRET=

# --- App ---
APP_ENV=development
CORS_ALLOW_ORIGINS=http://localhost:3000
# Coma-separado: emails o dominios que reciben rol admin/zuhma_member al iniciar sesión.
ZUHMA_ADMIN_EMAILS=oswaldo@zuhma.online
LEADHUB_MODE=stub          # stub | live
LEADHUB_BASE_URL=          # se usa cuando LEADHUB_MODE=live
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# FRONTEND (Next.js) — copia estas a frontend/.env.local (prefijo NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGEME_anon_key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Snippet de Odoo Livechat: id del canal y host de tu Odoo.
NEXT_PUBLIC_ODOO_LIVECHAT_URL=https://tuempresa.odoo.com
NEXT_PUBLIC_ODOO_LIVECHAT_CHANNEL=1
